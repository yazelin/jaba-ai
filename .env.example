# 資料庫設定
DB_NAME=jaba_ai
DB_USER=jaba_ai
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5433

# 應用程式設定
APP_PORT=8089

# 初始超級管理員（第一次啟動時自動建立，之後可刪除這兩行）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=your_admin_password
PROJECT_ROOT=/path/to/jaba-ai

# LINE Bot 設定
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# 申請頁面 URL
APP_URL=https://your-domain.com/jaba-ai

# AI 對話設定
CHAT_HISTORY_LIMIT=40  # 傳給 AI 的對話歷史筆數（預設 40）

# 安全設定
SECURITY_BAN_THRESHOLD=5  # 安全過濾觸發次數上限（預設 5）

# 執行設定
APP_RELOAD=false        # 開發時設 true 會自動重載；正式環境保持 false，改程式後重啟服務
AUTO_CLOSE_HOUR=15      # 每天幾點自動結束還開著的點餐（台北時間）

# AI 失敗通知：呼叫失敗（如登入過期）時推播給這個 LINE 使用者，一小時最多一次
ADMIN_LINE_USER_ID=
